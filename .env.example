# ── Core ─────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/giglet"
# Public base URL of the app (used in PayMob redirect/notification URLs)
APP_URL="http://localhost:3000"

# ── AI challenge generation (Groq) ─────────────────────────────
# Keep this key server-side; never expose it with a NEXT_PUBLIC_ prefix.
GROQ_API_KEY=
# Optional. Defaults to llama-3.3-70b-versatile.
GROQ_MODEL=

# ── PayMob (LIVE payments) ───────────────────────────────────────
# Get these from your PayMob dashboard  → Settings → Integration Details.
# If SECRET_KEY / PUBLIC_KEY / INTEGRATION_ID_CARD are ALL set, Giglet
# runs in LIVE mode (real card / wallet / Apple Pay charges).
# If any is missing, donations run in DEMO mode (practice money).
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID_CARD=

# Optional extra payment methods (extra integration ids from PayMob):
PAYMOB_INTEGRATION_ID_APPLE_PAY=

# Webhook verification — dashboard → Payment Response / Notification
# show “HMAC Secret”. Required before going live.
PAYMOB_HMAC_SECRET=

# Settlements currency, e.g. EGP or USD
# PAYMOB_CURRENCY=USD

# Apple Pay domain-association file contents
# (download from PayMob → Apple Pay settings, paste the file contents here).
# Without it, Apple Pay simply doesn't appear in checkout.
PAYMOB_APPLE_DOMAIN_ASSOC=
